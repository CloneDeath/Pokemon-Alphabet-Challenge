; Engine configuration file.
; Best edited using the Godot editor.

config_version=5

[application]

config/name="Pokémon Alphabet Challenge"
run/main_scene="res://main.tscn"
config/icon="res://assets/pokemon-logo.png"

[display]

window/size/viewport_width=390
window/size/viewport_height=844
window/size/window_width_override=390
window/size/window_height_override=844
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.035, 0.055, 0.105, 1)
